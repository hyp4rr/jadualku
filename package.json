{
  "name": "jadualku",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5181 --strictPort",
    "build": "tsc --noEmit && vite build && esbuild server/vercel.ts --bundle --platform=node --target=node20 --format=esm --outfile=api/index.js",
